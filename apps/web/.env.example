# Base URL of the SampTrek API
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional fallback: SampBidx base URL. Admins normally set it in Settings → Integrations. "Quick create > New bid" opens <url>/bids/new
NEXT_PUBLIC_SAMPBIDX_URL=

# Optional: white-label custom domains (docs/WHITE_LABEL.md). When true, pages served on any host other than
# NEXT_PUBLIC_WEB_ORIGIN call /api/v1 on the same host, and Next.js forwards it to API_INTERNAL_URL.
NEXT_PUBLIC_CUSTOM_DOMAINS=false
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
