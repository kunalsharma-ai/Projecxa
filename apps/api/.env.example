DATABASE_URL=postgresql://projexa:projexa@localhost:5432/projexa
# Database used by the e2e tests (it is reset by the tests)
TEST_DATABASE_URL=postgresql://projexa:projexa@localhost:5432/projexa_test
JWT_SECRET=change-me-to-a-long-random-string
# Encrypts two-step sign-in secrets (docs/MFA.md). Set it separately from JWT_SECRET and never change it,
# or everyone's authenticator app must be set up again. Falls back to JWT_SECRET when unset.
MFA_ENCRYPTION_KEY=change-me-to-another-long-random-string
PORT=4000
# Comma-separated origins allowed to call the API with cookies (the web app)
WEB_ORIGIN=http://localhost:3000
# Public base URL of this API, used when building respondent entry links
PUBLIC_BASE_URL=http://localhost:4000
# Disable the background callback worker (tests run it manually)
CALLBACK_WORKER_ENABLED=true
# Public API (docs/PUBLIC_API.md): requests per minute per API key. The same worker flag also sends event webhooks.
PUBLIC_API_RATE_LIMIT=120

# Outgoing email for scheduled reports (docs/SCHEDULED_REPORTS.md): Zoho Mail SMTP.
# Use smtp.zoho.in (India) or smtp.zoho.eu (EU) if your Zoho account is in that data centre.
# SMTP_PASS should be a Zoho application-specific password, not the mailbox password.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PROJEXA Reports <reports@yourcompany.com>"
REPORT_SCHEDULER_ENABLED=true

# Respondent security (docs/RESPONDENT_SECURITY.md)
# Request header with the respondent country from your CDN, e.g. cf-ipcountry. Unset = geolocation inactive.
GEO_COUNTRY_HEADER=
# TOR exit list refresh (set to false for offline installs)
TOR_EXIT_LIST_SYNC=true

# Fieldwork monitor (docs/FIELDWORK_MONITOR.md): five-minute pace and alert check
MONITOR_ENABLED=true
