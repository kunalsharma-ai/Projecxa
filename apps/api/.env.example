# ─── Server basics: the only settings PROJEXA needs here (docs/INTEGRATIONS.md) ───
# Everything below the "Optional fallbacks" line is set up by admins in Settings → Integrations instead.
DATABASE_URL=postgresql://projexa:projexa@localhost:5432/projexa
# Database used by the e2e tests (it is reset by the tests)
TEST_DATABASE_URL=postgresql://projexa:projexa@localhost:5432/projexa_test
JWT_SECRET=change-me-to-a-long-random-string
# Master key: encrypts secrets saved in Settings → Integrations, accounting tokens and two-step sign-in
# secrets (docs/MFA.md). Set it separately from JWT_SECRET and never change it. Falls back to JWT_SECRET when unset.
MFA_ENCRYPTION_KEY=change-me-to-another-long-random-string
PORT=4000
# Comma-separated origins allowed to call the API with cookies (the web app)
WEB_ORIGIN=http://localhost:3000
# Public base URL of this API, used when building respondent entry links
PUBLIC_BASE_URL=http://localhost:4000
# Disable the background callback worker (tests run it manually)
CALLBACK_WORKER_ENABLED=true
# Public API (docs/PUBLIC_API.md): requests per minute per API key. The same worker flag also sends event webhooks.
PUBLIC_API_RATE_LIMIT=120

# ─── Optional fallbacks ───
# Used only while an organisation has not set the same integration up in Settings → Integrations.

# Outgoing email (docs/SCHEDULED_REPORTS.md): Zoho Mail SMTP.
# Use smtp.zoho.in (India) or smtp.zoho.eu (EU) if your Zoho account is in that data centre.
# SMTP_PASS should be a Zoho application-specific password, not the mailbox password.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PROJEXA Reports <reports@yourcompany.com>"
REPORT_SCHEDULER_ENABLED=true
# Scheduled activation of redirect versions (docs/REDIRECT_DESTINATIONS.md)
REDIRECT_SCHEDULER_ENABLED=true
# Daily data-retention run (Settings → Privacy). Set false on all but one API instance.
PRIVACY_SCHEDULER_ENABLED=true
# Super Admin automation rules (docs/SUPER_ADMIN.md), checked hourly
AUTOMATION_SCHEDULER_ENABLED=true

# Single sign-on (docs/SSO.md). Leave a pair empty to hide that button.
# Redirect URI to register with each provider: ${PUBLIC_BASE_URL}/api/v1/auth/sso/<google|microsoft|zoho>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# The data centre where the Zoho API console client was created: accounts.zoho.in for India, .eu, .com.au, ...
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Respondent security (docs/RESPONDENT_SECURITY.md)
# Request header with the respondent country from your CDN, e.g. cf-ipcountry. Unset = geolocation inactive.
GEO_COUNTRY_HEADER=
# TOR exit list refresh (set to false for offline installs)
TOR_EXIT_LIST_SYNC=true

# Fieldwork monitor (docs/FIELDWORK_MONITOR.md): five-minute pace and alert check
MONITOR_ENABLED=true

# Direct sync to Zoho Books (docs/ZOHO_BOOKS.md). A Zoho self client with a refresh token for one
# Zoho Books organisation, usable only by the PROJEXA organisation whose slug is ZOHO_BOOKS_TENANT.
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
ZOHO_BOOKS_REFRESH_TOKEN=
ZOHO_BOOKS_ORGANIZATION_ID=
ZOHO_BOOKS_TENANT=
# Data centre: com, in, eu, com.au or jp.
ZOHO_BOOKS_DC=com

# AI copilot (docs/AI_COPILOT.md). Leave GEMINI_API_KEY empty to turn the copilot off.
GEMINI_API_KEY=
# Optional overrides
AI_MODEL=gemini-3.8-flash
# Used once when the main model is rate-limited; set empty for none
AI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_LIVE_MODEL=gemini-3.8-live
# GEMINI_API_URL=https://generativelanguage.googleapis.com

# Direct sync to Xero, QuickBooks Online and Tally Prime (docs/ACCOUNTING_SYNC.md)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Only for Xero apps created before March 2026 that still use broad scopes
# XERO_SCOPES=offline_access accounting.contacts accounting.transactions accounting.settings.read
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# sandbox while testing; leave empty for real companies
QUICKBOOKS_ENVIRONMENT=
# Tally Prime XML server, reachable privately (VPN), and the PROJEXA organisation slug that owns it
TALLY_URL=
TALLY_TENANT=
# Encrypts Xero and QuickBooks sign-in tokens (falls back to MFA_ENCRYPTION_KEY)
ACCOUNTING_ENCRYPTION_KEY=
# LEDGER_SCHEDULER_ENABLED=false

# PDF export (milestone 22). Optional: folder holding DejaVuSans.ttf and DejaVuSans-Bold.ttf.
# Defaults to apps/api/assets/fonts, which ships with the repo.
# PDF_FONT_DIR=

# Redirect health link check: allow client survey hosts on private networks (on-premises only). docs/REDIRECT_HEALTH.md
LINK_CHECK_ALLOW_PRIVATE=false
