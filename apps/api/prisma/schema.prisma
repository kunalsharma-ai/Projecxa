// PROJEXA data model, milestone 1.
// Hierarchy: Organization → Client → Project (master) → ProjectCountry → QuotaCell / VendorAllocation → RespondentSession
// Every tenant-owned row carries organizationId so queries can always be scoped to one tenant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Tenancy and identity ─────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// Organization-level default redirect rules (lowest precedence). Shape: RedirectConfig.
  defaultRedirectConfig Json?
  /// Hostnames respondents may be redirected to (exact host or "*.example.com").
  redirectAllowedDomains String[] @default([])
  /// Shown to respondents when no rule resolves or a destination is blocked.
  fallbackRedirectUrl String?
  /// Next numbers for human-readable IDs (FRP10001, FR9001 style).
  projectSeq   Int @default(10000)
  workOrderSeq Int @default(9000)
  projectCodePrefix   String @default("PRX")
  workOrderPrefix     String @default("WO")
  /// Shared secret Bidzo signs "bid won" webhooks with (HMAC-SHA256). Null = intake disabled.
  bidzoWebhookSecret  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  clients     Client[]
  vendors     Vendor[]
  projects    Project[]
  sessions    RespondentSession[]
  auditEvents AuditEvent[]
  callbacks   CallbackDelivery[]
  wonBids     WonBid[]
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  SALES
  VIEWER
  CLIENT_USER
  VENDOR_USER
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  name           String
  passwordHash   String
  role           Role     @default(PROJECT_MANAGER)
  active         Boolean  @default(true)
  /// Set for CLIENT_USER (client portal) and VENDOR_USER (vendor portal) only.
  clientId       String?
  client         Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vendorId       String?
  vendor         Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  /// Personal interface preferences (theme, density, motion, sidebar, favorites). Validated by the API.
  preferences    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  managedProjects Project[] @relation("ProjectManager")
  salesProjects   Project[] @relation("SalesPerson")

  @@unique([organizationId, email])
  @@index([email])
}

// ───────────────────────────── Clients and vendors ─────────────────────────────

enum PartyStatus {
  ACTIVE
  INACTIVE
}

model Client {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  status         PartyStatus @default(ACTIVE)
  /// Approved client redirect template (precedence below project config).
  redirectTemplate Json?
  /// Secret for verifying client server-to-server outcome postbacks (HMAC-SHA256).
  s2sSecret      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contacts ClientContact[]
  projects Project[]
  users    User[]

  @@unique([organizationId, code])
}

model ClientContact {
  id        String  @id @default(cuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  projects  Project[]
}

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  status         PartyStatus @default(ACTIVE)
  /// Extra redirect hostnames allowed for this vendor only.
  redirectAllowedDomains String[] @default([])
  /// Default server-to-server callback URL template (may use macros).
  callbackUrlTemplate String?
  /// Secret used to sign callbacks we send to this vendor.
  callbackSecret String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  allocations VendorAllocation[]
  users       User[]

  @@unique([organizationId, code])
}

// ───────────────────────────── Projects ─────────────────────────────

enum ProjectType {
  AD_HOC
  TRACKER
  LONGITUDINAL
  QUALITATIVE
}

enum ProjectStatus {
  DRAFT
  TEST
  LIVE
  HOLD
  CLOSED
  INVOICED
}

enum RedirectMode {
  STATIC
  DYNAMIC
  HYBRID
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Human-readable project ID, e.g. PRX10001. Unique per tenant.
  projectCode    String
  workOrderNo    String?
  /// Reference to the won bid in Bidzo (Bidzo owns bids; we only keep the link).
  bidReference   String?
  name           String
  type           ProjectType   @default(AD_HOC)
  category       String
  status         ProjectStatus @default(DRAFT)
  description    String?
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  clientContactId String?
  clientContact  ClientContact? @relation(fields: [clientContactId], references: [id])
  projectManagerId String
  projectManager User     @relation("ProjectManager", fields: [projectManagerId], references: [id])
  salesPersonId  String?
  salesPerson    User?    @relation("SalesPerson", fields: [salesPersonId], references: [id])
  /// { desktop: boolean, mobile: boolean, tablet: boolean }
  devices        Json
  /// Security & respondent quality policy (gate survey, captcha, duplicate detection, ...).
  security       Json
  redirectMode   RedirectMode @default(HYBRID)
  activeRedirectVersionId String? @unique
  activeRedirectVersion   RedirectPolicyVersion? @relation("ActiveRedirectVersion", fields: [activeRedirectVersionId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  countries        ProjectCountry[]
  redirectVersions RedirectPolicyVersion[] @relation("ProjectRedirectVersions")
  sessions         RespondentSession[]
  wonBid           WonBid?

  @@unique([organizationId, projectCode])
  @@index([organizationId, status])
}

enum CountryStatus {
  DRAFT
  TEST
  LIVE
  HOLD
  CLOSED
}

model ProjectCountry {
  id              String  @id @default(cuid())
  projectId       String
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// ISO 3166-1 alpha-2
  countryCode     String
  language        String
  targetGroup     String?
  status          CountryStatus @default(DRAFT)
  loiMinutes      Int
  irPercent       Int
  /// Client CPI in `currency`.
  cpi             Decimal @db.Decimal(12, 2)
  currency        String  @default("USD")
  targetCompletes Int
  /// Count of completes accepted against the country target (updated atomically).
  completes       Int     @default(0)
  /// Client survey live link. Supports {session_token}, {country_code}, {project_code} macros.
  liveSurveyUrl   String?
  testSurveyUrl   String?
  /// Session lifetime; defaults to 4 × LOI, minimum 60 minutes.
  sessionTtlMinutes Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quotas      QuotaCell[]
  allocations VendorAllocation[]
  sessions    RespondentSession[]

  @@unique([projectId, countryCode, language])
}

model QuotaCell {
  id               String  @id @default(cuid())
  projectCountryId String
  projectCountry   ProjectCountry @relation(fields: [projectCountryId], references: [id], onDelete: Cascade)
  name             String
  /// Free-form criteria description for now; structured targeting comes with Module 6.
  criteria         Json?
  target           Int
  completes        Int     @default(0)
  createdAt        DateTime @default(now())
}

enum AllocationStatus {
  ACTIVE
  PAUSED
  CLOSED
}

model VendorAllocation {
  id               String  @id @default(cuid())
  projectCountryId String
  projectCountry   ProjectCountry @relation(fields: [projectCountryId], references: [id], onDelete: Cascade)
  vendorId         String
  vendor           Vendor  @relation(fields: [vendorId], references: [id])
  status           AllocationStatus @default(ACTIVE)
  /// Vendor payout per complete, in the country currency.
  cpi              Decimal @db.Decimal(12, 2)
  targetCompletes  Int
  completes        Int     @default(0)
  /// Opaque public code used in the vendor entry link: /s/{entryCode}
  entryCode        String  @unique
  /// Opaque code for the test entry link (sessions are flagged isTest, never billable).
  testEntryCode    String  @unique
  /// Query parameter name the vendor uses for its respondent ID (default "uid").
  uidParam         String  @default("uid")
  /// Overrides Vendor.callbackUrlTemplate for this allocation.
  callbackUrlTemplate String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions RespondentSession[]

  @@unique([projectCountryId, vendorId])
}

// ───────────────────────────── Redirect policy (Module 5.1) ─────────────────────────────

enum RedirectVersionState {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// One immutable version of a project's redirect configuration. The `config` JSON
/// holds rules for every scope (project, country, vendor, vendor+country) and the
/// parameter alias mappings. See src/redirects/redirect.types.ts (RedirectConfig).
model RedirectPolicyVersion {
  id            String  @id @default(cuid())
  projectId     String
  project       Project @relation("ProjectRedirectVersions", fields: [projectId], references: [id], onDelete: Cascade)
  activeFor     Project? @relation("ActiveRedirectVersion")
  version       Int
  state         RedirectVersionState @default(DRAFT)
  mode          RedirectMode
  config        Json
  changeReason  String?
  createdById   String
  approvedById  String?
  previousVersionId String?
  createdAt     DateTime @default(now())
  activatedAt   DateTime?

  sessions RespondentSession[]

  @@unique([projectId, version])
}

// ───────────────────────────── Respondent sessions and events (Module 5) ─────────────────────────────

enum RespondentStatus {
  STARTED
  COMPLETE
  TERMINATE
  QUOTA_FULL
  QUALITY_FAIL
  DUPLICATE
  SECURITY_REJECT
  PARTIAL
  TECHNICAL_ERROR
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_APPLICABLE
}

model RespondentSession {
  id               String  @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectCountryId String
  projectCountry   ProjectCountry @relation(fields: [projectCountryId], references: [id], onDelete: Cascade)
  vendorAllocationId String
  vendorAllocation VendorAllocation @relation(fields: [vendorAllocationId], references: [id], onDelete: Cascade)
  /// Opaque random token handed to the client survey instead of the vendor UID.
  token            String  @unique
  /// The respondent ID supplied by the vendor. Kept server side; only returned to that vendor.
  vendorRespondentId String
  status           RespondentStatus @default(STARTED)
  /// Internal detail that can share one external status (e.g. ABANDONED / TIMED_OUT under PARTIAL).
  statusDetail     String?
  /// True once the outcome was confirmed server-to-server by the client survey platform.
  outcomeVerified  Boolean @default(false)
  approval         ApprovalStatus @default(NOT_APPLICABLE)
  isTest           Boolean @default(false)
  /// Redirect configuration version used to process this session (historical traceability).
  redirectVersionId String?
  redirectVersion  RedirectPolicyVersion? @relation(fields: [redirectVersionId], references: [id])
  revenue          Decimal? @db.Decimal(12, 2)
  payout           Decimal? @db.Decimal(12, 2)
  ipHash           String?
  userAgent        String?
  startedAt        DateTime @default(now())
  outcomeAt        DateTime?
  expiresAt        DateTime

  events     RespondentEvent[]
  executions RedirectExecution[]

  @@unique([vendorAllocationId, vendorRespondentId, isTest])
  @@index([projectId, status])
  @@index([organizationId, startedAt])
}

enum EventSource {
  ENTRY
  BROWSER
  S2S
  SYSTEM
  QA
}

model RespondentEvent {
  id             String  @id @default(cuid())
  sessionId      String
  session        RespondentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type           String
  status         RespondentStatus?
  source         EventSource
  /// Unique per logical event; repeated deliveries are ignored.
  idempotencyKey String  @unique
  detail         Json?
  createdAt      DateTime @default(now())

  @@index([sessionId])
}

model RedirectExecution {
  id            String  @id @default(cuid())
  sessionId     String?
  session       RespondentSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status        RespondentStatus
  /// Which precedence level produced the rule (e.g. "vendor+country", "project", "organization").
  ruleSource    String?
  versionId     String?
  destination   String
  usedFallback  Boolean @default(false)
  blockedReason String?
  durationMs    Int
  createdAt     DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

// ───────────────────────────── Callbacks (transactional outbox) ─────────────────────────────

enum CallbackState {
  PENDING
  QUEUED
  SENDING
  DELIVERED
  RETRY_SCHEDULED
  FAILED
  DEAD_LETTER
  CANCELLED
}

model CallbackDelivery {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessionId      String?
  targetType     String
  targetId       String?
  url            String
  method         String  @default("GET")
  body           Json?
  /// One callback per (session, status, target); retries reuse the same key.
  idempotencyKey String  @unique
  state          CallbackState @default(PENDING)
  attempts       Int     @default(0)
  maxAttempts    Int     @default(6)
  nextAttemptAt  DateTime @default(now())
  lastStatusCode Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([state, nextAttemptAt])
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditEvent {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  action         String
  entityType     String
  entityId       String
  detail         Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, entityType, entityId])
}

enum WonBidStatus {
  /// Waiting for a PM to set up the project.
  NEW
  PROJECT_CREATED
  DISMISSED
}

/// A bid won in Bidzo, received by webhook. One row per Bidzo bid; a project is created from it at most once.
model WonBid {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source         String  @default("BIDZO")
  /// Bidzo's bid id; with source and organization it makes repeated deliveries idempotent.
  externalId     String
  bidNumber      String
  bidVersion     Int?
  projectName    String
  description    String?
  projectType    String?
  projectCategory String?
  clientName     String
  clientExternalId String?
  contactName    String?
  contactEmail   String?
  bidderName     String?
  currency       String
  totalAmount    Decimal? @db.Decimal(18, 4)
  /// [{ countryCode, sampleSize, loiMinutes, incidencePct, cpi, notes }]
  countries      Json
  wonAt          DateTime
  status         WonBidStatus @default(NEW)
  dismissReason  String?
  projectId      String? @unique
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Last delivery's event id and full payload, kept for support.
  lastEventId    String?
  payload        Json
  deliveries     Int     @default(1)
  receivedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, source, externalId])
  @@index([organizationId, status])
}
