// SampTrek data model, milestone 1.
// Hierarchy: Organization → Client → Project (master) → ProjectCountry → QuotaCell / VendorAllocation → RespondentSession
// Every tenant-owned row carries organizationId so queries can always be scoped to one tenant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Tenancy and identity ─────────────────────────────

model Organization {
  id                     String      @id @default(cuid())
  name                   String
  slug                   String      @unique
  /// Organization-level default redirect rules (lowest precedence). Shape: RedirectConfig.
  defaultRedirectConfig  Json?
  /// Hostnames respondents may be redirected to (exact host or "*.example.com").
  redirectAllowedDomains String[]    @default([])
  /// Shown to respondents when no rule resolves or a destination is blocked.
  fallbackRedirectUrl    String?
  /// Signs requests to API redirect destinations (X-Projexa-Signature). Made on first use.
  redirectSigningSecret  String?
  /// Next numbers for human-readable IDs (FRP10001, FR9001 style).
  projectSeq             Int         @default(10000)
  workOrderSeq           Int         @default(9000)
  /// Invoice numbers: INV-<year>-<seq>, sequence per tenant.
  invoiceSeq             Int         @default(0)
  /// Vendor bill numbers: BILL-<year>-<seq>.
  billSeq                Int         @default(0)
  /// Finance settings (docs/PAYABLES.md): reporting currency and default taxes.
  baseCurrency           String      @default("USD")
  invoiceTaxName         String?
  invoiceTaxPercent      Decimal     @default(0) @db.Decimal(5, 2)
  billTaxName            String?
  billTaxPercent         Decimal     @default(0) @db.Decimal(5, 2)
  /// Staff must turn on two-step sign-in before using the app (portal users may opt in).
  mfaRequired            Boolean     @default(false)
  /// Single sign-on (docs/SSO.md): { providers: { google, microsoft, zoho }, domains: [], microsoftTenantId?, ssoOnly }
  ssoConfig              Json?
  /// Account and ledger names for accounting exports (docs/ACCOUNTING_EXPORTS.md).
  accountingConfig       Json?
  /// Direct sync to Zoho Books: { enabled, hourly, since, invoices, bills, payments }. Credentials live in env only.
  zohoBooksConfig        Json?
  /// Seller details printed on invoice PDFs: { legalName, address, taxId, email, phone, bankDetails, footer }.
  invoiceProfile         Json?
  /// AI copilot settings (docs/AI_COPILOT.md): { enabled, voice, documents, actions, roles, perUserDaily, orgDaily }.
  aiSettings             Json?
  /// Fieldwork alert thresholds (src/monitor/monitor.rules.ts); null = defaults.
  alertSettings          Json?
  /// Optional HTTPS endpoint that receives new alerts, signed with alertWebhookSecret (HMAC-SHA256).
  alertWebhookUrl        String?
  alertWebhookSecret     String?
  projectCodePrefix      String      @default("PRX")
  workOrderPrefix        String      @default("WO")
  /// The last work order number generated automatically (shown on Create project and in Settings → Numbering).
  lastWorkOrderNo        String?
  /// Put in front of every respondent UID (session token) we send to client surveys, e.g. "SMP-". Null = none.
  uidPrefix              String?
  /// Shared secret Bidzo signs "bid won" webhooks with (HMAC-SHA256). Null = intake disabled.
  bidzoWebhookSecret     String?
  /// Free third-party captcha keys set by an admin: { turnstile?: { siteKey, secret }, hcaptcha?: { siteKey, secret } }.
  captchaProviders       Json?
  pageAssets             PageAsset[]
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  users                  User[]
  clients                Client[]
  vendors                Vendor[]
  projects               Project[]
  sessions               RespondentSession[]
  auditEvents            AuditEvent[]
  callbacks              CallbackDelivery[]
  wonBids                WonBid[]
  invoices               Invoice[]
  reconciliations        Reconciliation[]
  alerts                 Alert[]
  vendorBills            VendorBill[]
  exchangeRates          ExchangeRate[]
  apiKeys                ApiKey[]
  webhookEndpoints       WebhookEndpoint[]
  webhookDeliveries      WebhookDelivery[]
  reportSchedules        ReportSchedule[]
  accountingExports      AccountingExport[]
  zohoBooksLinks         ZohoBooksLink[]
  zohoBooksSyncs         ZohoBooksSync[]
  ledgerConnections      LedgerConnection[]
  ledgerLinks            LedgerLink[]
  ledgerSyncs            LedgerSync[]
  reportViews            SavedReportView[]
  projectTemplates       ProjectTemplate[]
  projectDrafts          ProjectDraft[]
  tasks                  Task[]
  aiConversations        AiConversation[]
  aiActions              AiAction[]
  customOptions          CustomOption[]
  partyLogos             PartyLogo[]
  clientUniqueLinks      ClientUniqueLink[]
  aiUsage                AiUsage[]
  aiDocuments            AiDocument[]
  tickets                Ticket[]
  sharedFiles            SharedFile[]
  vendorApplications     VendorApplication[]
  quoteRequests          QuoteRequest[]
  /// Public vendor sign-up link token; null when sign-up is off.
  vendorSignupToken      String?              @unique
  /// Retention settings (docs/PRIVACY.md): { respondentDays, eventDays }; null = keep everything.
  retention              Json?
  retentionRunAt         DateTime?
  consentPolicies        ConsentPolicy[]
  /// White-label (docs/WHITE_LABEL.md): { appName, tagline, brandColor, theme, hidePoweredBy, supportEmail, emailFromName, emailReplyTo, loginMessage }.
  branding               Json?
  brandAssets            BrandAsset[]
  questionSets           QuestionSet[]
  /// Custom web domain for this organisation (e.g. research.acme.com), used once verified by DNS.
  customDomain           String?              @unique
  customDomainToken      String?
  customDomainVerifiedAt DateTime?
  /// Integrations set up in Settings → Integrations (docs/INTEGRATIONS.md).
  integrations           IntegrationSetting[]
  /// The organisation that runs this SampTrek server. Its admins set the server-wide sign-in and accounting apps. Null on every org = the oldest one.
  platformOwner          Boolean              @default(false)
  /// Super Admin (docs/SUPER_ADMIN.md): PENDING = registered, waiting for approval; SUSPENDED = nobody can use the app.
  status                 OrgStatus            @default(ACTIVE)
  /// Self-registration details: { contactName, phone, website, message, requestedPlan, ip }.
  registration           Json?
  /// Platform settings (platform owner only): { registrationOpen, defaultPlanCode, trialDays }.
  platformSettings       Json?
  subscription           Subscription?
  featureOverrides       FeatureOverride[]
  automationRuns         AutomationRun[]
  billingInvoices        BillingInvoice[]
}

enum OrgStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

/// A feature package the Super Admin sells or assigns (docs/SUPER_ADMIN.md). No payments are taken.
model Plan {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  description    String?
  /// Shown to people, e.g. "INR 4,999 a month". Used when no price is set below.
  priceLabel     String?
  /// What organisations pay for the plan (docs/SUBSCRIPTION_PAYMENTS.md); null = cannot be bought for that period.
  priceMonthly   Decimal?         @db.Decimal(12, 2)
  priceYearly    Decimal?         @db.Decimal(12, 2)
  currency       String           @default("INR")
  /// Feature keys (src/super-admin/features.ts) included on the web.
  features       String[]         @default([])
  /// Feature keys included in the Android and iOS app.
  mobileFeatures String[]         @default([])
  mobileEnabled  Boolean          @default(true)
  /// Active staff users allowed; null = no limit.
  maxUsers       Int?
  /// Projects allowed; null = no limit.
  maxProjects    Int?
  active         Boolean          @default(true)
  sortOrder      Int              @default(0)
  subscriptions  Subscription[]
  invoices       BillingInvoice[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  /// Still works; a reminder that renewal is late.
  PAST_DUE
  EXPIRED
  CANCELLED
}

/// One organisation's subscription. An organisation without one keeps every feature (installs from before Super Admin).
model Subscription {
  id              String             @id @default(cuid())
  organizationId  String             @unique
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId          String
  plan            Plan               @relation(fields: [planId], references: [id])
  status          SubscriptionStatus @default(ACTIVE)
  startsAt        DateTime           @default(now())
  /// Renewal or end date; after it the subscription stops working (unless PAST_DUE is set by hand).
  endsAt          DateTime?
  trialEndsAt     DateTime?
  /// Overrides the plan's limits for this organisation; null = the plan's.
  maxUsers        Int?
  maxProjects     Int?
  /// Turns the mobile app off for the whole organisation, whatever the plan says.
  mobileEnabled   Boolean            @default(true)
  /// How the organisation last paid for it: MONTHLY or YEARLY (null = set by hand).
  billingInterval BillingInterval?
  notes           String?
  updatedById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

/// Super Admin switch for one feature of one organisation, on top of its plan.
model FeatureOverride {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feature        String
  /// web | mobile
  channel        String
  enabled        Boolean
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, feature, channel])
}

/// Super Admin automation: when <trigger>, if <conditions>, then <actions> (docs/SUPER_ADMIN.md).
model AutomationRule {
  id            String          @id @default(cuid())
  name          String
  enabled       Boolean         @default(true)
  /// org.registered | org.created | trial.ending | subscription.expiring | subscription.ended | org.inactive | seats.exceeded | integration.failing
  trigger       String
  /// e.g. { days: 7 }
  triggerConfig Json            @default("{}")
  /// { plans?: string[], statuses?: string[], orgStatuses?: string[] }
  conditions    Json            @default("{}")
  /// [{ type, ...params }]
  actions       Json            @default("[]")
  recipe        String?
  lastRunAt     DateTime?
  runCount      Int             @default(0)
  createdById   String?
  runs          AutomationRun[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum BillingInvoiceStatus {
  /// Waiting to be paid (online checkout started, or issued by the Super Admin).
  OPEN
  /// Paid offline; the organisation sent the details and the Super Admin must confirm.
  PENDING_REVIEW
  PAID
  /// The Super Admin did not find the offline payment.
  REJECTED
  CANCELLED
}

/// A subscription invoice from the server owner to an organisation (docs/SUBSCRIPTION_PAYMENTS.md).
model BillingInvoice {
  id                String               @id @default(cuid())
  /// SUB-2026-00001
  number            String               @unique
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId            String
  plan              Plan                 @relation(fields: [planId], references: [id])
  interval          BillingInterval
  currency          String
  amount            Decimal              @db.Decimal(12, 2)
  taxName           String?
  taxPercent        Decimal              @default(0) @db.Decimal(5, 2)
  taxAmount         Decimal              @default(0) @db.Decimal(12, 2)
  total             Decimal              @db.Decimal(12, 2)
  status            BillingInvoiceStatus @default(OPEN)
  /// razorpay | stripe | bank_transfer | upi | cheque | cash | other
  method            String?
  /// Razorpay order id or Stripe Checkout Session id.
  providerOrderId   String?              @unique
  providerPaymentId String?
  /// Bank / UPI / cheque reference given for an offline payment, or the gateway payment id.
  reference         String?
  paidOn            DateTime?
  note              String?
  proofName         String?
  proofType         String?
  proofData         Bytes?
  reviewNote        String?
  reviewedById      String?
  periodStart       DateTime?
  periodEnd         DateTime?
  paidAt            DateTime?
  createdById       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([organizationId, createdAt])
  @@index([status])
}

model AutomationRun {
  id             String         @id @default(cuid())
  ruleId         String
  rule           AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The same rule acts once per organisation and key (e.g. the subscription end date).
  dedupeKey      String
  /// ok | failed
  status         String
  detail         Json?
  createdAt      DateTime       @default(now())

  @@unique([ruleId, organizationId, dedupeKey])
  @@index([createdAt])
}

/// One integration's settings for an organisation (docs/INTEGRATIONS.md). Secrets are AES-256-GCM encrypted JSON.
model IntegrationSetting {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// smtp | sso_google | sso_microsoft | sso_zoho | gemini | zoho_books | xero | quickbooks | tally | bidzo
  kind            String
  values          Json         @default("{}")
  secrets         String?
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?
  updatedById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, kind])
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  SALES
  VIEWER
  CLIENT_USER
  VENDOR_USER
}

model User {
  id                 String          @id @default(cuid())
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email              String
  name               String
  passwordHash       String
  role               Role            @default(PROJECT_MANAGER)
  active             Boolean         @default(true)
  /// Set for CLIENT_USER (client portal) and VENDOR_USER (vendor portal) only.
  clientId           String?
  client             Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vendorId           String?
  vendor             Vendor?         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  /// Personal interface preferences (theme, density, motion, sidebar, favorites). Validated by the API.
  preferences        Json?
  /// Two-step sign-in (docs/MFA.md). TOTP secrets are encrypted at rest (AES-256-GCM).
  mfaSecret          String?
  /// Secret waiting for its first code during setup.
  mfaPendingSecret   String?
  mfaEnabledAt       DateTime?
  /// SHA-256 hashes of unused one-time recovery codes.
  mfaRecoveryCodes   String[]        @default([])
  /// Last accepted 30-second step, so a code cannot be used twice.
  mfaLastStep        Int?
  /// Wrong codes in a row; 10 locks the second step for 15 minutes.
  mfaFailures        Int             @default(0)
  mfaLockedUntil     DateTime?
  /// Command center widgets: order, size and visibility (null = the default layout).
  dashboardLayout    Json?
  /// Product tour (docs/PRODUCT_TOUR.md): the tour version this person finished or skipped, how, and when. Null = not seen yet.
  tourVersion        Int?
  tourOutcome        String?
  tourAt             DateTime?
  ssoIdentities      SsoIdentity[]
  /// When the person last chose a password. Null for someone invited who has not set one yet.
  passwordSetAt      DateTime?
  lastLoginAt        DateTime?
  /// Sessions issued before this time are rejected (password reset, deactivation, sign out everywhere).
  sessionsValidAfter DateTime?
  /// Runs the whole SampTrek server (docs/SUPER_ADMIN.md). Honoured only in the platform owner organisation.
  superAdmin         Boolean         @default(false)
  /// Super Admin: this person may use the Android and iOS app.
  mobileAccess       Boolean         @default(true)
  /// Super Admin: features turned off for this person on the web and in the app / in the app only.
  featuresOff        String[]        @default([])
  mobileFeaturesOff  String[]        @default([])
  /// Last authenticated request (written at most every 5 minutes).
  lastSeenAt         DateTime?
  passwordTokens     PasswordToken[]
  notificationReads  NotificationRead[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  managedProjects  Project[]                @relation("ProjectManager")
  salesProjects    Project[]                @relation("SalesPerson")
  tasksAssigned    Task[]                   @relation("TaskAssignee")
  tasksCreated     Task[]                   @relation("TaskCreator")
  reportViews      SavedReportView[]
  projectTemplates ProjectTemplate[]
  projectDrafts    ProjectDraft[]
  projectVersions  ProjectSettingsVersion[]
  pushDevices      PushDevice[]
  mobileSsoCodes   MobileSsoCode[]

  @@unique([organizationId, email])
  @@index([email])
}

// ───────────────────────────── Clients and vendors ─────────────────────────────

enum PartyStatus {
  ACTIVE
  INACTIVE
}

model Client {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  code             String
  status           PartyStatus  @default(ACTIVE)
  /// Approved client redirect template (precedence below project config).
  redirectTemplate Json?
  /// Secret for verifying client server-to-server outcome postbacks (HMAC-SHA256).
  s2sSecret        String
  /// Printed under "Bill to" on invoice PDFs.
  billingAddress   String?
  taxId            String?
  /// Client website, normalised to https://host[/path].
  website          String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  logo        PartyLogo?
  contacts    ClientContact[]
  projects    Project[]
  users       User[]
  invoices    Invoice[]
  tickets     Ticket[]
  sharedFiles SharedFile[]

  @@unique([organizationId, code])
}

model ClientContact {
  id       String    @id @default(cuid())
  clientId String
  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name     String
  email    String?
  phone    String?
  projects Project[]
}

model Vendor {
  id                     String       @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                   String
  code                   String
  status                 PartyStatus  @default(ACTIVE)
  /// Extra redirect hostnames allowed for this vendor only.
  redirectAllowedDomains String[]     @default([])
  /// Default server-to-server callback URL template (may use macros).
  callbackUrlTemplate    String?
  /// Secret used to sign callbacks we send to this vendor.
  callbackSecret         String
  /// The vendor's own redirect URL per outcome status ({ COMPLETE: "https://...", ... }); macros allowed.
  /// Project rules use them through the {vendor_redirect} macro (docs/CLIENTS_VENDORS_EDITING.md).
  redirectUrls           Json?
  website                String?
  contactName            String?
  contactEmail           String?
  contactPhone           String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  logo          PartyLogo?
  allocations   VendorAllocation[]
  users         User[]
  bills         VendorBill[]
  capacity      VendorCapacity[]
  tickets       Ticket[]
  sharedFiles   SharedFile[]
  quoteRequests QuoteRequest[]
  applications  VendorApplication[]

  @@unique([organizationId, code])
}

// ───────────────────────────── Projects ─────────────────────────────

enum ProjectType {
  AD_HOC
  TRACKER
  LONGITUDINAL
  QUALITATIVE
}

enum ProjectStatus {
  DRAFT
  TEST
  LIVE
  HOLD
  CLOSED
  INVOICED
}

enum RedirectMode {
  STATIC
  DYNAMIC
  HYBRID
}

model Project {
  id                      String                 @id @default(cuid())
  organizationId          String
  organization            Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Human-readable project ID, e.g. PRX10001. Unique per tenant.
  projectCode             String
  workOrderNo             String?
  /// Reference to the won bid in Bidzo (Bidzo owns bids; we only keep the link).
  bidReference            String?
  name                    String
  /// What vendors see instead of the internal name, which can reveal the client. Null = "Survey <code>".
  vendorTitle             String?
  type                    ProjectType            @default(AD_HOC)
  category                String
  status                  ProjectStatus          @default(DRAFT)
  description             String?
  clientId                String
  client                  Client                 @relation(fields: [clientId], references: [id])
  clientContactId         String?
  clientContact           ClientContact?         @relation(fields: [clientContactId], references: [id])
  projectManagerId        String
  projectManager          User                   @relation("ProjectManager", fields: [projectManagerId], references: [id])
  salesPersonId           String?
  salesPerson             User?                  @relation("SalesPerson", fields: [salesPersonId], references: [id])
  /// { desktop: boolean, mobile: boolean, tablet: boolean }
  devices                 Json
  /// Security & respondent quality policy (gate survey, captcha, duplicate detection, ...).
  security                Json
  /// Gate survey questions (asked after the human check when security.gateSurvey is on).
  /// Same question model as the prescreener; see src/survey/questions.ts.
  gateQuestions           Json?
  /// Prescreener questions (asked after the gate survey when security.prescreening is on).
  prescreen               Json?
  /// Human check style on the gate page: math | logic | text_image | invisible | turnstile | hcaptcha.
  captchaStyle            String                 @default("math")
  /// Look of the respondent-facing pages (gate and end pages); see src/survey/page-design.ts.
  pageDesign              Json?
  /// Planned fieldwork window; pacing compares the delivery rate with the days left.
  fieldStartAt            DateTime?
  fieldEndAt              DateTime?
  /// Fieldwork autopilot settings, see src/monitor/monitor.rules.ts.
  autopilot               Json?
  /// What the autopilot has done and switched off on its own (auto-pause checkpoints); server-owned. See src/monitor/auto-pause.ts.
  autopilotState          Json?
  /// Speeder check: { enabled, fraction: "1/3" }. A complete faster than fraction × planned LOI becomes QUALITY_FAIL / SPEEDER.
  speederCheck            Json?
  redirectMode            RedirectMode           @default(HYBRID)
  activeRedirectVersionId String?                @unique
  activeRedirectVersion   RedirectPolicyVersion? @relation("ActiveRedirectVersion", fields: [activeRedirectVersionId], references: [id])
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  countries         ProjectCountry[]
  redirectVersions  RedirectPolicyVersion[]   @relation("ProjectRedirectVersions")
  uniqueLinks       UniqueLink[]
  uniqueLinkBatches UniqueLinkBatch[]
  sessions          RespondentSession[]
  invoices          Invoice[]
  reconciliations   Reconciliation[]
  alerts            Alert[]
  wonBid            WonBid?
  tasks             Task[]
  settingsVersions  ProjectSettingsVersion[]
  tickets           Ticket[]
  sharedFiles       SharedFile[]
  sampleonRequests  SampleonAudienceRequest[]
  clientUniqueLinks ClientUniqueLink[]
  /// How the gate/prescreener questions used by quota cells map onto SUPPLY360 profile attributes, for SAMPLEON.
  /// { "gate:<questionId>": { attribute, values: { <answerId>: value } } }; see src/sampleon/quota-translate.ts.
  sampleonQuotaMap  Json?

  @@unique([organizationId, projectCode])
  @@index([organizationId, status])
}

enum CountryStatus {
  DRAFT
  TEST
  LIVE
  HOLD
  CLOSED
}

/// Options people add themselves to a dropdown ("Add +"), e.g. a project category or target group.
/// `field` names the dropdown; `defaultVendor` rows list the vendors preselected on Create project.
model CustomOption {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  field          String
  value          String
  createdById    String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, field, value])
}

model ProjectCountry {
  id                String        @id @default(cuid())
  projectId         String
  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// ISO 3166-1 alpha-2
  countryCode       String
  language          String
  targetGroup       String?
  status            CountryStatus @default(DRAFT)
  loiMinutes        Int
  irPercent         Int
  /// Client CPI in `currency`.
  cpi               Decimal       @db.Decimal(12, 2)
  currency          String        @default("USD")
  targetCompletes   Int
  /// Count of completes accepted against the country target (updated atomically).
  completes         Int           @default(0)
  /// Client survey live link. Supports {session_token}, {country_code}, {project_code} macros.
  liveSurveyUrl     String?
  testSurveyUrl     String?
  /// Session lifetime; defaults to 4 × LOI, minimum 60 minutes.
  sessionTtlMinutes Int?
  /// Client unique links (docs/CLIENT_UNIQUE_LINKS.md): each live respondent gets the next unused
  /// link the client gave us, instead of liveSurveyUrl.
  useClientLinks    Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  quotas        QuotaCell[]
  allocations   VendorAllocation[]
  sessions      RespondentSession[]
  quoteRequests QuoteRequest[]
  clientLinks   ClientUniqueLink[]

  /// The same country may appear more than once (one market per target group); the app keeps
  /// country + language + target group unique within a project.
  @@index([projectId])
}

model QuotaCell {
  id               String         @id @default(cuid())
  projectCountryId String
  projectCountry   ProjectCountry @relation(fields: [projectCountryId], references: [id], onDelete: Cascade)
  /// Display group, e.g. "Gender" or "Age x Region". Cells in a group usually do not overlap.
  group            String         @default("")
  name             String
  /// Legacy free-form description from milestone 1. Superseded by `conditions`.
  criteria         Json?
  /// All must match: [{ source: device|gate|prescreen, questionId?, values?, min?, max? }]. See docs/QUOTAS.md.
  conditions       Json           @default("[]")
  target           Int
  /// Completes counted against this cell (updated atomically with the country count).
  completes        Int            @default(0)
  /// Closed cells send matching respondents to quota full even below target.
  isOpen           Boolean        @default(true)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt

  @@index([projectCountryId])
}

enum AllocationStatus {
  ACTIVE
  PAUSED
  CLOSED
}

model VendorAllocation {
  id                  String           @id @default(cuid())
  projectCountryId    String
  projectCountry      ProjectCountry   @relation(fields: [projectCountryId], references: [id], onDelete: Cascade)
  vendorId            String
  vendor              Vendor           @relation(fields: [vendorId], references: [id])
  status              AllocationStatus @default(ACTIVE)
  /// Vendor payout per complete, in the country currency.
  cpi                 Decimal          @db.Decimal(12, 2)
  targetCompletes     Int
  completes           Int              @default(0)
  /// Opaque public code used in the vendor entry link: /s/{entryCode}
  entryCode           String           @unique
  /// Opaque code for the test entry link (sessions are flagged isTest, never billable).
  testEntryCode       String           @unique
  /// Query parameter name the vendor uses for its respondent ID (default "uid").
  uidParam            String           @default("uid")
  /// Overrides Vendor.callbackUrlTemplate for this allocation.
  callbackUrlTemplate String?
  /// When true the shared live entry link is refused and respondents can only enter through
  /// one-time unique links (docs/UNIQUE_LINKS.md). The test link keeps working.
  uniqueLinksOnly     Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  sessions          RespondentSession[]
  uniqueLinks       UniqueLink[]
  uniqueLinkBatches UniqueLinkBatch[]

  @@unique([projectCountryId, vendorId])
}

// ───────────────────────────── Redirect policy (Module 5.1) ─────────────────────────────

enum RedirectVersionState {
  DRAFT
  /// Approved to go live at scheduledAt.
  SCHEDULED
  ACTIVE
  ARCHIVED
}

/// One immutable version of a project's redirect configuration. The `config` JSON
/// holds rules for every scope (project, country, vendor, vendor+country) and the
/// parameter alias mappings. See src/redirects/redirect.types.ts (RedirectConfig).
model RedirectPolicyVersion {
  id                String               @id @default(cuid())
  projectId         String
  project           Project              @relation("ProjectRedirectVersions", fields: [projectId], references: [id], onDelete: Cascade)
  activeFor         Project?             @relation("ActiveRedirectVersion")
  version           Int
  state             RedirectVersionState @default(DRAFT)
  mode              RedirectMode
  config            Json
  changeReason      String?
  createdById       String
  approvedById      String?
  /// When a SCHEDULED version goes live, who scheduled it, and why the last attempt failed.
  scheduledAt       DateTime?
  scheduledById     String?
  scheduleError     String?
  previousVersionId String?
  createdAt         DateTime             @default(now())
  activatedAt       DateTime?

  sessions RespondentSession[]

  @@unique([projectId, version])
  @@index([state, scheduledAt])
}

// ───────────────────────────── Respondent sessions and events (Module 5) ─────────────────────────────

enum RespondentStatus {
  STARTED
  COMPLETE
  TERMINATE
  QUOTA_FULL
  QUALITY_FAIL
  DUPLICATE
  SECURITY_REJECT
  PARTIAL
  TECHNICAL_ERROR
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_APPLICABLE
}

model RespondentSession {
  id                 String                 @id @default(cuid())
  organizationId     String
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId          String
  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectCountryId   String
  projectCountry     ProjectCountry         @relation(fields: [projectCountryId], references: [id], onDelete: Cascade)
  vendorAllocationId String
  vendorAllocation   VendorAllocation       @relation(fields: [vendorAllocationId], references: [id], onDelete: Cascade)
  /// Opaque random token handed to the client survey instead of the vendor UID.
  token              String                 @unique
  /// The respondent ID supplied by the vendor. Kept server side; only returned to that vendor.
  vendorRespondentId String
  status             RespondentStatus       @default(STARTED)
  /// Internal detail that can share one external status (e.g. ABANDONED / TIMED_OUT under PARTIAL).
  statusDetail       String?
  /// True once the outcome was confirmed server-to-server by the client survey platform.
  outcomeVerified    Boolean                @default(false)
  approval           ApprovalStatus         @default(NOT_APPLICABLE)
  /// When the approval was last decided (by hand, the client portal or a reconciliation).
  approvalAt         DateTime?
  /// Set once this approved complete is billed; locked against further approval changes until the invoice is voided.
  invoiceId          String?
  invoice            Invoice?               @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  /// Set once this approved complete is on a vendor bill; voiding the bill releases it.
  vendorBillId       String?
  vendorBill         VendorBill?            @relation(fields: [vendorBillId], references: [id], onDelete: SetNull)
  isTest             Boolean                @default(false)
  /// Redirect configuration version used to process this session (historical traceability).
  redirectVersionId  String?
  redirectVersion    RedirectPolicyVersion? @relation(fields: [redirectVersionId], references: [id])
  revenue            Decimal?               @db.Decimal(12, 2)
  payout             Decimal?               @db.Decimal(12, 2)
  ipHash             String?
  userAgent          String?
  /// desktop | mobile | tablet, from the user agent at entry.
  deviceType         String?
  /// Country reported by the edge (GEO_COUNTRY_HEADER), when configured.
  geoCountry         String?
  /// True when the respondent must pass the gate page before the client survey link is released.
  gateRequired       Boolean                @default(false)
  gatePassedAt       DateTime?
  /// Visible human check on the gate page (max 3 attempts).
  humanAttempts      Int                    @default(0)
  humanPassedAt      DateTime?
  /// Answers given on the gate page: { gate: {...}, prescreen: {...} }, each { questionId: { value, label } }.
  answers            Json?
  /// Quota cells this respondent qualified for (set at entry or after the gate page).
  quotaCellIds       String[]               @default([])
  /// Tenant-scoped hashes of the browser fingerprint and the long-lived browser cookie.
  fingerprintHash    String?
  browserIdHash      String?
  startedAt          DateTime               @default(now())
  outcomeAt          DateTime?
  expiresAt          DateTime
  /// Consent the respondent gave on the gate page (when a consent notice applies to the market).
  consentAt          DateTime?
  consentVersion     Int?
  /// Personal data removed (retention or an erasure request); counts, outcome and money are kept.
  anonymizedAt       DateTime?
  /// The one-time unique link this respondent entered through (at most one session per link).
  uniqueLinkId       String?                @unique
  uniqueLink         UniqueLink?            @relation(fields: [uniqueLinkId], references: [id], onDelete: SetNull)
  /// The client unique link this respondent was sent to (at most one).
  clientLink         ClientUniqueLink?

  events     RespondentEvent[]
  executions RedirectExecution[]

  @@unique([vendorAllocationId, vendorRespondentId, isTest])
  @@index([projectId, status])
  @@index([projectId, fingerprintHash])
  @@index([projectId, browserIdHash])
  @@index([projectId, ipHash])
  @@index([organizationId, startedAt])
  @@index([invoiceId])
  @@index([vendorBillId])
}

// ───────────────────────────── One-time unique links (docs/UNIQUE_LINKS.md) ─────────────────────────────

enum UniqueLinkStatus {
  UNUSED
  /// Claimed by the first respondent who opened it; it can never be entered again.
  USED
  REVOKED
}

/// One "Generate N links" run for a vendor in a market.
enum ClientLinkStatus {
  UNUSED
  ASSIGNED
}

/**
 * Client unique links: survey links the client made, one per respondent. Uploaded per market;
 * each live respondent is given the next unused one (atomically). docs/CLIENT_UNIQUE_LINKS.md.
 */
model ClientUniqueLink {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectCountryId String
  projectCountry   ProjectCountry     @relation(fields: [projectCountryId], references: [id], onDelete: Cascade)
  url              String
  /// Upload order; links are handed out lowest first.
  seq              Int
  status           ClientLinkStatus   @default(UNUSED)
  sessionId        String?            @unique
  session          RespondentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  assignedAt       DateTime?
  /// Name of the uploaded file or a label typed by the person.
  label            String?
  createdById      String?
  createdAt        DateTime           @default(now())

  @@unique([projectCountryId, url])
  @@index([projectCountryId, status, seq])
  @@index([projectId])
}

/**
 * Logo of a client or vendor (small image, any common format). Kept apart so lists stay light.
 */
model PartyLogo {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?      @unique
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vendorId       String?      @unique
  vendor         Vendor?      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  contentType    String
  data           Bytes
  hash           String
  bytes          Int
  updatedAt      DateTime     @updatedAt
}

model UniqueLinkBatch {
  id                 String           @id @default(cuid())
  organizationId     String
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorAllocationId String
  vendorAllocation   VendorAllocation @relation(fields: [vendorAllocationId], references: [id], onDelete: Cascade)
  label              String?
  count              Int
  /// Links in the batch stop working after this time (null = no expiry).
  expiresAt          DateTime?
  createdById        String?
  createdAt          DateTime         @default(now())

  links UniqueLink[]

  @@index([projectId, createdAt])
}

/// A single-use respondent link: /u/{key}. The key is random and unguessable; the first
/// respondent to open it claims it atomically and nobody can enter with it again.
model UniqueLink {
  id                 String           @id @default(cuid())
  organizationId     String
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorAllocationId String
  vendorAllocation   VendorAllocation @relation(fields: [vendorAllocationId], references: [id], onDelete: Cascade)
  batchId            String
  batch              UniqueLinkBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  key                String           @unique
  status             UniqueLinkStatus @default(UNUSED)
  usedAt             DateTime?
  /// Number of times someone tried to open the link after it was used, revoked or expired.
  blockedAttempts    Int              @default(0)
  lastBlockedAt      DateTime?
  revokedAt          DateTime?
  createdAt          DateTime         @default(now())

  session RespondentSession?

  @@index([projectId, status])
  @@index([vendorAllocationId, status])
  @@index([batchId])
}

enum EventSource {
  ENTRY
  BROWSER
  S2S
  SYSTEM
  QA
}

model RespondentEvent {
  id             String            @id @default(cuid())
  sessionId      String
  session        RespondentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type           String
  status         RespondentStatus?
  source         EventSource
  /// Unique per logical event; repeated deliveries are ignored.
  idempotencyKey String            @unique
  detail         Json?
  createdAt      DateTime          @default(now())

  @@index([sessionId])
}

model RedirectExecution {
  id            String             @id @default(cuid())
  sessionId     String?
  session       RespondentSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status        RespondentStatus
  /// Which precedence level produced the rule (e.g. "vendor+country", "project", "organization").
  ruleSource    String?
  versionId     String?
  destination   String
  usedFallback  Boolean            @default(false)
  blockedReason String?
  durationMs    Int
  /// API destinations: the endpoint failed and the rule's fallback URL was used.
  apiFallback   Boolean            @default(false)
  createdAt     DateTime           @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

// ───────────────────────────── Callbacks (transactional outbox) ─────────────────────────────

enum CallbackState {
  PENDING
  QUEUED
  SENDING
  DELIVERED
  RETRY_SCHEDULED
  FAILED
  DEAD_LETTER
  CANCELLED
}

model CallbackDelivery {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessionId      String?
  targetType     String
  targetId       String?
  url            String
  method         String        @default("GET")
  body           Json?
  /// One callback per (session, status, target); retries reuse the same key.
  idempotencyKey String        @unique
  state          CallbackState @default(PENDING)
  attempts       Int           @default(0)
  maxAttempts    Int           @default(6)
  nextAttemptAt  DateTime      @default(now())
  lastStatusCode Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([state, nextAttemptAt])
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  action         String
  entityType     String
  entityId       String
  detail         Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
  @@index([createdAt])
}

enum WonBidStatus {
  /// Waiting for a PM to set up the project.
  NEW
  PROJECT_CREATED
  DISMISSED
}

/// A bid won in Bidzo, received by webhook. One row per Bidzo bid; a project is created from it at most once.
model WonBid {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source           String       @default("BIDZO")
  /// Bidzo's bid id; with source and organization it makes repeated deliveries idempotent.
  externalId       String
  bidNumber        String
  bidVersion       Int?
  projectName      String
  description      String?
  projectType      String?
  projectCategory  String?
  clientName       String
  clientExternalId String?
  contactName      String?
  contactEmail     String?
  bidderName       String?
  currency         String
  totalAmount      Decimal?     @db.Decimal(18, 4)
  /// [{ countryCode, sampleSize, loiMinutes, incidencePct, cpi, notes }]
  countries        Json
  wonAt            DateTime
  status           WonBidStatus @default(NEW)
  dismissReason    String?
  projectId        String?      @unique
  project          Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Last delivery's event id and full payload, kept for support.
  lastEventId      String?
  payload          Json
  deliveries       Int          @default(1)
  receivedAt       DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, source, externalId])
  @@index([organizationId, status])
}

/// Current TOR exit node addresses (refreshed from the TOR Project bulk exit list).
model TorExitNode {
  ip        String   @id
  updatedAt DateTime @updatedAt
}

/// Images uploaded for respondent pages (logo, hero, background). Served publicly at /pa/:id.
model PageAsset {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  contentType    String
  size           Int
  data           Bytes
  createdAt      DateTime     @default(now())

  @@index([organizationId, projectId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

/// Client invoice for approved completes of one project, in one currency.
model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  number         String
  status         InvoiceStatus @default(DRAFT)
  currency       String
  /// [{ countryCode, description, quantity, unitPrice, amount }]
  lines          Json
  completes      Int
  /// Sum of the lines, before tax.
  subtotal       Decimal       @default(0) @db.Decimal(14, 2)
  taxName        String?
  taxPercent     Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(14, 2)
  /// subtotal + taxAmount.
  total          Decimal       @db.Decimal(14, 2)
  notes          String?
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  voidedAt       DateTime?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  /// Bank or payment reference, recorded when paid.
  paymentReference  String?
  /// Last time this invoice went into an accounting export.
  exportedAt        DateTime?
  /// Last time its payment went into a payments export.
  paymentExportedAt DateTime?

  sessions RespondentSession[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([projectId])
}

/// One applied reconciliation: the client's final list of valid IDs for a project.
model Reconciliation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// final_list: listed approved, others rejected · approve_listed · reject_listed
  mode           String
  submitted      Int
  matched        Int
  approved       Int
  rejected       Int
  unchanged      Int
  unknown        Int
  locked         Int
  /// Up to 50 IDs that matched nothing, for follow-up with the client.
  unknownSample  Json?
  note           String?
  actorId        String?
  createdAt      DateTime     @default(now())

  @@index([projectId, createdAt])
}

enum AlertState {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// A fieldwork problem found by the monitor. One unresolved alert per dedupeKey; it resolves itself when the condition clears.
model Alert {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId          String?
  project            Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectCountryId   String?
  vendorAllocationId String?
  /// stalled | behind_pace | low_ir | loi_short | loi_long | quality_spike | drop_off | quota_near | target_reached | callbacks_failed
  rule               String
  /// info | warn | bad
  severity           String
  title              String
  detail             String
  metrics            Json?
  dedupeKey          String
  state              AlertState   @default(OPEN)
  /// What the autopilot did about it, if anything (e.g. "Paused Panel Alpha in US").
  autoAction         String?
  webhookStatus      String?
  firstSeenAt        DateTime     @default(now())
  lastSeenAt         DateTime     @default(now())
  acknowledgedAt     DateTime?
  acknowledgedById   String?
  resolvedAt         DateTime?
  /// "auto" when the condition cleared, otherwise the user id.
  resolvedBy         String?

  @@index([organizationId, state])
  @@index([organizationId, dedupeKey])
  @@index([projectId, state])
}

enum VendorBillStatus {
  DRAFT
  APPROVED
  PAID
  VOID
}

/// What we owe a vendor for its approved completes, in one currency, across projects.
model VendorBill {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendorId         String
  vendor           Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  number           String
  status           VendorBillStatus @default(DRAFT)
  currency         String
  /// Completes with an outcome up to this time were included (null = everything approved).
  periodTo         DateTime?
  /// [{ projectId, projectCode, countryCode, description, quantity, unitPrice, amount }]
  lines            Json
  completes        Int
  subtotal         Decimal          @db.Decimal(14, 2)
  taxName          String?
  taxPercent       Decimal          @default(0) @db.Decimal(5, 2)
  taxAmount        Decimal          @default(0) @db.Decimal(14, 2)
  total            Decimal          @db.Decimal(14, 2)
  /// The vendor's own invoice number, recorded on approval.
  vendorReference  String?
  /// Bank or payment reference, recorded when paid.
  paymentReference String?
  notes            String?
  approvedAt       DateTime?
  dueAt            DateTime?
  paidAt           DateTime?
  voidedAt         DateTime?
  createdById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  /// Last time this bill went into an accounting export.
  exportedAt        DateTime?
  /// Last time its payment went into a payments export.
  paymentExportedAt DateTime?

  sessions RespondentSession[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([vendorId])
}

/// Manual exchange rate: 1 unit of `currency` = `rate` units of the organisation's base currency.
model ExchangeRate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currency       String
  rate           Decimal      @db.Decimal(18, 8)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, currency])
}

/// Key for the public API (docs/PUBLIC_API.md). Only a SHA-256 hash is stored; the key is shown once.
model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// First characters of the key (pjx_xxxxxxxx), shown in lists so people can tell keys apart.
  prefix         String
  keyHash        String       @unique
  /// e.g. projects:read, projects:write, sessions:read, quotas:read, finance:read
  scopes         String[]
  /// The admin who created it. Writes through the key are recorded as this person.
  createdById    String
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

/// An HTTPS endpoint that receives signed event webhooks.
model WebhookEndpoint {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String
  description    String?
  secret         String
  /// Event names this endpoint receives (see src/webhooks/webhook.events.ts).
  events         String[]
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deliveries     WebhookDelivery[]

  @@index([organizationId])
}

/// One event sent (or to be sent) to one endpoint, with retries.
model WebhookDelivery {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event          String
  /// Same for every endpoint that receives this event, so receivers can de-duplicate.
  eventId        String
  payload        Json
  state          CallbackState   @default(PENDING)
  attempts       Int             @default(0)
  maxAttempts    Int             @default(8)
  nextAttemptAt  DateTime        @default(now())
  lastStatusCode Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())

  @@index([state, nextAttemptAt])
  @@index([endpointId, createdAt])
}

/// A report emailed on a schedule (docs/SCHEDULED_REPORTS.md).
model ReportSchedule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// overall | client | vendor | project | country | day
  report         String
  /// yesterday | last_7_days | last_30_days | month_to_date | last_month
  period         String
  /// Optional filters: { clientId?, vendorId?, projectId? }
  filters        Json         @default("{}")
  /// daily | weekly | monthly
  frequency      String
  /// 0 = Sunday … 6 = Saturday (weekly)
  dayOfWeek      Int?
  /// 1–28 (monthly)
  dayOfMonth     Int?
  /// Local hour 0–23 in `timezone`
  hour           Int
  timezone       String       @default("Asia/Kolkata")
  recipients     String[]
  /// Do not send when the period had no traffic.
  skipEmpty      Boolean      @default(false)
  /// Attach a PDF of the report as well as the CSV.
  attachPdf      Boolean      @default(false)
  active         Boolean      @default(true)
  nextRunAt      DateTime
  lastRunAt      DateTime?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  runs           ReportRun[]

  @@index([active, nextRunAt])
  @@index([organizationId])
}

model ReportRun {
  id         String         @id @default(cuid())
  scheduleId String
  schedule   ReportSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  /// SENT | FAILED | SKIPPED
  status     String
  /// scheduled | manual
  trigger    String
  from       String
  to         String
  rows       Int            @default(0)
  recipients String[]
  error      String?
  createdAt  DateTime       @default(now())

  @@index([scheduleId, createdAt])
}

/// A Google, Microsoft or Zoho account linked to a SampTrek user. After the first sign-in the
/// provider's stable subject is used, never the email again.
model SsoIdentity {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// google | microsoft | zoho
  provider   String
  /// The provider's stable user id (Microsoft: tenant id + object id).
  subject    String
  email      String
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([provider, subject])
  @@index([userId])
}

/// A file of invoices and/or vendor bills made for an accounting system. The file is kept so it can be downloaded again.
model AccountingExport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// zoho_books | tally | quickbooks | xero | journal
  format         String
  /// invoices | bills | both
  kind           String
  /// Filters used, for the history list.
  filters        Json
  invoiceCount   Int
  billCount      Int
  fileName       String
  contentType    String
  content        String
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

/// One-time link to set a password: an invitation (72 hours) or a reset (30 minutes). Only a SHA-256 hash is stored.
model PasswordToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// invite | reset
  purpose     String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

/// A SampTrek record that exists in Zoho Books, so a sync never creates it twice.
model ZohoBooksLink {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// customer | vendor | invoice | bill | invoice_payment | bill_payment
  entityType     String
  entityId       String
  zohoId         String
  /// Zoho Books status we last set: sent, open, paid, void.
  state          String?
  syncedAt       DateTime     @default(now())

  @@unique([organizationId, entityType, entityId])
}

/// One run of the Zoho Books sync, for the history list.
model ZohoBooksSync {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// manual | schedule
  trigger        String
  /// running | ok | partial | failed
  status         String
  /// { customers, vendors, invoices, bills, paymentsReceived, paymentsMade, voided }
  counts         Json?
  /// [{ type, number, message }]
  errors         Json?
  createdById    String?
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?

  @@index([organizationId, startedAt])
}

/// A saved set of report filters (docs/REPORT_VIEWS.md). Shared views are visible to all staff.
model SavedReportView {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  /// Overall | Conversion | Clients | Vendors | Clicks
  tab            String
  /// today | 7 | 30 | 90 | month | all | custom (custom keeps the dates in filters)
  period         String
  /// { from?, to?, clientId?, vendorId?, projectId?, countryCode? }
  filters        Json         @default("{}")
  shared         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, ownerId])
}

/// A connection to Xero, QuickBooks Online or Tally Prime (docs/ACCOUNTING_SYNC.md).
model LedgerConnection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// xero | quickbooks | tally
  provider       String
  /// connected | expired | disconnected
  status         String       @default("connected")
  /// Xero tenant id or QuickBooks realm (company) id.
  remoteId       String?
  remoteName     String?
  /// OAuth tokens, AES-GCM encrypted with ACCOUNTING_ENCRYPTION_KEY. Never returned by the API.
  tokens         String?
  /// { hourly, since, invoices, bills, payments }
  settings       Json?
  lastError      String?
  connectedById  String?
  connectedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, provider])
}

/// A SampTrek record that reached Xero, QuickBooks or Tally, so a sync never creates it twice.
model LedgerLink {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String
  /// customer | vendor | invoice | bill | invoice_payment | bill_payment
  entityType     String
  entityId       String
  remoteId       String
  /// sent, open, paid, void
  state          String?
  syncedAt       DateTime     @default(now())

  @@unique([organizationId, provider, entityType, entityId])
}

/// One sync run to Xero, QuickBooks or Tally.
model LedgerSync {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String
  /// manual | schedule
  trigger        String
  /// running | ok | partial | failed
  status         String
  counts         Json?
  errors         Json?
  createdById    String?
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?

  @@index([organizationId, provider, startedAt])
}

// ───────────────────────────── Tasks ─────────────────────────────

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// A piece of work for a person, optionally on a project. Created by people or by the AI copilot (after confirmation).
model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  status         TaskStatus   @default(OPEN)
  priority       TaskPriority @default(MEDIUM)
  assigneeId     String?
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  dueAt          DateTime?
  /// When to remind the assignee (shown in their notifications from then on).
  remindAt       DateTime?
  /// When the reminder went to the assignee's phone (so it is pushed once).
  remindPushedAt DateTime?
  /// This task cannot start until that one is done.
  blockedById    String?
  blockedBy      Task?        @relation("TaskDependency", fields: [blockedById], references: [id], onDelete: SetNull)
  blocking       Task[]       @relation("TaskDependency")
  /// manual | ai
  source         String       @default("manual")
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([assigneeId, status])
  @@index([projectId])
}

// ───────────────────────────── AI copilot ─────────────────────────────

model AiConversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  title          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  messages       AiMessage[]

  @@index([organizationId, userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// user | assistant | tool
  role           String
  /// Provider-neutral parts: [{ text } | { call: { id, name, args } } | { result: { id, name, data } } | { document: { id, name } }]
  content        Json
  /// Visual blocks for the screen (tables, charts) built from tool results, and pending action ids.
  display        Json?
  /// voice | text
  channel        String         @default("text")
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

/// A change the copilot proposed. Nothing happens until the person confirms it.
model AiAction {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  conversationId String?
  tool           String
  args           Json
  /// What will happen, in words, shown on the confirmation card.
  summary        String
  /// pending | done | cancelled | failed | expired
  status         String       @default("pending")
  result         Json?
  error          String?
  createdAt      DateTime     @default(now())
  decidedAt      DateTime?

  @@index([organizationId, userId, status])
}

/// One call to the AI provider, for usage tracking and limits.
model AiUsage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  provider       String
  model          String
  /// chat | voice | voice_tool | title
  kind           String
  promptTokens   Int          @default(0)
  outputTokens   Int          @default(0)
  ok             Boolean      @default(true)
  error          String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

/// A file uploaded to the copilot to read (PDF, text, images). Visible only to the person who uploaded it.
model AiDocument {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  name           String
  mimeType       String
  size           Int
  data           Bytes
  createdAt      DateTime     @default(now())

  @@index([organizationId, userId, createdAt])
}

/// A reusable project setup. `form` prefills the Create project form; `extras` are copied
/// into the new project when it is created from the template. See docs/PROJECT_TEMPLATES.md.
model ProjectTemplate {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  createdById     String?
  createdBy       User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Project the template was saved from (kept as text; the project may be deleted later).
  sourceProjectId String?
  /// { type, category, clientId, description, devices, security, redirectMode, defaults, countries }
  form            Json
  /// { include, captchaStyle, gateQuestions, prescreen, pageDesign, autopilot, redirectConfig, quotas, vendors }
  extras          Json
  useCount        Int          @default(0)
  lastUsedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, name])
}

/// An unfinished Create project form, saved as the person types. Private to its owner.
model ProjectDraft {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title          String
  data           Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, ownerId])
}

/// One saved state of a project's settings, written whenever they change.
model ProjectSettingsVersion {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   Int
  /// Full settings after this change (see src/projects/project-history.ts).
  snapshot  Json
  /// [{ field, label, before, after }]
  changes   Json     @default("[]")
  reason    String?
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([projectId, version])
}

/// What a vendor says it can deliver in one market. Rows also mark the markets it covers.
model VendorCapacity {
  id                String   @id @default(cuid())
  vendorId          String
  vendor            Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  /// ISO 3166-1 alpha-2
  countryCode       String
  completesPerDay   Int?
  completesPerMonth Int?
  note              String?
  updatedAt         DateTime @updatedAt

  @@unique([vendorId, countryCode])
}

// ───────────────────────────── Portal requests and shared files (milestone 26) ─────────────────────────────

enum TicketKind {
  QUESTION
  ISSUE
  /// A vendor disputes completes the client rejected.
  DISPUTE
}

enum TicketStatus {
  /// Waiting for staff.
  OPEN
  /// Staff answered; waiting for the client or vendor.
  ANSWERED
  CLOSED
}

/// A request between a client or vendor company and the operating organisation.
model Ticket {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Per-organisation number shown as REQ-<number>.
  number         Int
  kind           TicketKind   @default(QUESTION)
  status         TicketStatus @default(OPEN)
  subject        String
  /// Exactly one of clientId / vendorId: whose request it is.
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vendorId       String?
  vendor         Vendor?      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Disputes: the respondent sessions in question.
  sessionIds     String[]
  createdById    String
  assigneeId     String?
  lastMessageAt  DateTime     @default(now())
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages TicketMessage[]
  files    SharedFile[]

  @@unique([organizationId, number])
  @@index([organizationId, status, lastMessageAt])
  @@index([clientId])
  @@index([vendorId])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  /// True when written by a client or vendor user.
  fromPortal Boolean  @default(false)
  /// Staff-only note, never shown in a portal.
  internal   Boolean  @default(false)
  body       String
  createdAt  DateTime @default(now())

  @@index([ticketId, createdAt])
}

enum SharedFileKind {
  QUESTIONNAIRE
  DELIVERABLE
  COMPLIANCE
  OTHER
}

/// A document shared between staff and one client or one vendor. Stored in the database (10 MB cap).
/// Staff-only files have neither clientId nor vendorId.
model SharedFile {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           SharedFileKind @default(OTHER)
  name           String
  contentType    String
  size           Int
  sha256         String
  data           Bytes
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vendorId       String?
  vendor         Vendor?        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticketId       String?
  ticket         Ticket?        @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  note           String?
  /// Compliance documents: when it stops being valid.
  expiresAt      DateTime?
  uploadedById   String
  /// True when a client or vendor user uploaded it.
  fromPortal     Boolean        @default(false)
  createdAt      DateTime       @default(now())

  @@index([organizationId, projectId])
  @@index([organizationId, vendorId, kind])
  @@index([organizationId, clientId])
  @@index([ticketId])
}

// ───────────────────────────── Vendor sign-up and quote requests (milestone 27) ─────────────────────────────

enum VendorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A panel company that applied through the public sign-up page. Approving it creates the vendor.
model VendorApplication {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         VendorApplicationStatus @default(PENDING)
  companyName    String
  website        String?
  contactName    String
  email          String
  phone          String?
  /// ISO country codes the panel covers.
  countries      String[]
  /// Panel members, as the applicant states it.
  panelSize      Int?
  /// e.g. B2B, B2C, HEALTHCARE, AUTOMOTIVE.
  specialties    String[]
  message        String?
  /// sha256(organisation + IP), to spot repeat submissions without storing the address.
  ipHash         String?
  reviewedById   String?
  reviewedAt     DateTime?
  rejectReason   String?
  vendorId       String?
  vendor         Vendor?                 @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdAt      DateTime                @default(now())

  @@index([organizationId, status, createdAt])
  @@index([organizationId, email])
}

enum QuoteRequestStatus {
  /// Sent to the vendor, waiting for an answer.
  REQUESTED
  QUOTED
  DECLINED
  /// Staff accepted it and a vendor link was created.
  ACCEPTED
  /// Staff closed it without accepting (another vendor won, or the market closed).
  CLOSED
}

/// Feasibility and CPI asked of one vendor for one project market.
model QuoteRequest {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectCountryId  String
  projectCountry    ProjectCountry     @relation(fields: [projectCountryId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  status            QuoteRequestStatus @default(REQUESTED)
  /// The brief as sent, so later project edits do not change what the vendor quoted on.
  completesWanted   Int
  loiMinutes        Int
  irPercent         Int
  targetGroup       String?
  note              String?
  respondBy         DateTime?
  requestedById     String
  /// The vendor's answer.
  cpi               Decimal?           @db.Decimal(10, 2)
  currency          String
  feasibleCompletes Int?
  daysNeeded        Int?
  vendorNote        String?
  respondedById     String?
  respondedAt       DateTime?
  allocationId      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([projectCountryId, vendorId])
  @@index([organizationId, status])
  @@index([vendorId, status])
}

/// Consent notice respondents must accept before the survey, per market ("*" = every other market).
model ConsentPolicy {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  countryCode    String
  enabled        Boolean      @default(true)
  title          String
  body           String
  privacyUrl     String?
  /// Goes up whenever the wording or link changes; sessions record the version they accepted.
  version        Int          @default(1)
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, countryCode])
}

/// Logo and icon images for white-labelling, served publicly (they appear on sign-in pages and in emails).
model BrandAsset {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// logo, logoDark or icon
  kind           String
  contentType    String
  data           Bytes
  hash           String
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, kind])
}

/// A phone that gets push notifications for one person (docs/MOBILE_APP.md → Push notifications).
model PushDevice {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Expo push token, ExponentPushToken[...]
  token          String    @unique
  /// ios | android
  platform       String
  name           String?
  /// What the person wants to hear about: alerts | requests | tasks | won_bids
  categories     String[]  @default([])
  lastSeenAt     DateTime  @default(now())
  lastSentAt     DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([organizationId])
}

/// One-time code that hands a Google, Microsoft or Zoho sign-in from the phone's browser to the app.
/// Only works with the PKCE verifier the app made for that sign-in; 2 minutes, once.
model MobileSsoCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  challenge String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// An audience request this project has with SAMPLEON, the Sampledge audience and routing engine
/// (SAMPLEON docs/ECOSYSTEM_ARCHITECTURE.md). SampTrek owns the project, its targets and approved
/// changes; SAMPLEON owns targeting, feasibility, invitations, routing and live quota counting;
/// SUPPLY360 owns the respondents. Progress here comes from SAMPLEON's signed events and is kept
/// apart from ProjectCountry.completes, which counts respondents SampTrek itself routed.
model SampleonAudienceRequest {
  id                String    @id @default(cuid())
  organizationId    String
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// SAMPLEON's Audience Request ID (AR-…), the correlation id of every event.
  audienceRequestId String    @unique
  /// The client survey (e.g. the ZAPX survey id) the request is for.
  surveyId          String
  status            String
  requiredCompletes Int
  completes         Int       @default(0)
  remaining         Int?
  /// Sent with the project's quota cells translated to SUPPLY360 attributes (re-sent on sync).
  usesProjectQuotas Boolean   @default(false)
  /// Latest project.quota_updated snapshot: { byCountry, quotas }.
  progress          Json      @default("{}")
  progressSequence  Int       @default(0)
  lastEventType     String?
  lastEventAt       DateTime?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId, projectId])
}

/// SAMPLEON events already processed (deduplicated by event id).
model SampleonInboundEvent {
  eventId           String   @id
  type              String
  audienceRequestId String?
  receivedAt        DateTime @default(now())
}

/// One person has read one notification (docs/NOTIFICATIONS.md). Notifications are worked out live, so
/// `key` is the notification's id and `title` the wording it had: when the wording changes (for example
/// "3 callbacks failed" becomes "5 callbacks failed") it counts as new again.
model NotificationRead {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key            String
  title          String
  readAt         DateTime @default(now())

  @@unique([userId, key])
  @@index([readAt])
}

/// An organisation's own gate survey question set (docs/GATE_QUESTION_SETS.md): either its edited
/// version of a built-in audience set (key = b2b, b2c, parents, teens, hc_consumer, hc_patient,
/// hc_caregiver) or a set it made itself (key = custom-…).
model QuestionSet {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  name           String
  description    String?
  questions      Json
  updatedById    String?
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())

  @@unique([organizationId, key])
}
