{
  "expo": {
    "name": "SampTrek",
    "slug": "projexa",
    "scheme": "projexa",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0820"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sampledge.projexa",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SampTrek uses the microphone when you talk to the AI copilot."
      }
    },
    "android": {
      "package": "com.sampledge.projexa",
      "adaptiveIcon": {
        "backgroundColor": "#0B0820",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "SampTrek uses the microphone when you talk to the AI copilot.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8B5CF6",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "",
      "webUrl": ""
    }
  }
}
